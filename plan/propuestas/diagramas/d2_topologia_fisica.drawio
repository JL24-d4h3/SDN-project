        <!-- Puertos -->
        <mxCell id="p_a1" value="A1 · VLAN 10 untagged&#xa;p3–p19: equipos físicos&#xa;p20 → NIC-B: 16 hosts académicos 10.1.0.10–.25&#xa;ma1 → canal OOB" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=10.5;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="90" y="400" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="p_a2" value="A2 · VLAN 10 untagged&#xa;p3–p5: equipos físicos&#xa;p6 → NIC-E: operadores .30–.31 · atacante interno .50 · puente demo MAC_Moved&#xa;ma1 → canal OOB" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=10.5;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="320" y="400" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="p_a3" value="A3 · VLAN 30 untagged&#xa;p3: Servicio General .10&#xa;p4: Privilegiado .11&#xa;p5: Crítico (BD) .12&#xa;p6 → NIC-A: trunk VLAN 20 (gestión)&#xa;ma1 → canal OOB" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=10.5;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="550" y="400" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="p_a4" value="A4 · VLAN 40&#xa;p3: acceso externo&#xa;p4 → NIC-C: VM atacante externo 10.3.0.10&#xa;p47 → NIC-D: ESPEJO (solo RX)&#xa;ma1 → canal OOB" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=10.5;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="780" y="400" width="180" height="120" as="geometry"/></mxCell>

        <!-- Servidor -->
        <mxCell id="srv" value="SERVIDOR DEL LABORATORIO — hipervisor KVM/libvirt · ≥ 32 GB RAM · 24 VMs + contenedores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;fontSize=13.5;fontStyle=1;fontColor=#0F172A;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="90" y="560" width="870" height="150" as="geometry"/></mxCell>
        <mxCell id="nic_a" value="NIC-A&#xa;trunk VLAN 20&#xa;plano de contenedores&#xa;(10 servicios + infra)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9A4D00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="110" y="600" width="156" height="92" as="geometry"/></mxCell>
        <mxCell id="nic_b" value="NIC-B&#xa;16 VMs académicas&#xa;10.1.0.10–.25&#xa;52:54:00:01:xx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3B6E9E;fontSize=10;" vertex="1" parent="1"><mxGeometry x="286" y="600" width="156" height="92" as="geometry"/></mxCell>
        <mxCell id="nic_c" value="NIC-C&#xa;VM atacante externo&#xa;10.3.0.10&#xa;VLAN 40 tagged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#A33B33;fontSize=10;" vertex="1" parent="1"><mxGeometry x="462" y="600" width="156" height="92" as="geometry"/></mxCell>
