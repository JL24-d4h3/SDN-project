        <mxCell id="oob_nc2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;dashPattern=4 4;strokeColor=#B91C1C;strokeWidth=1.1;" edge="1" parent="1" source="nc2" target="oob"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oob_a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;dashPattern=4 4;strokeColor=#B91C1C;strokeWidth=1.1;" edge="1" parent="1" source="a1" target="oob"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oob_a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;dashPattern=4 4;strokeColor=#B91C1C;strokeWidth=1.1;" edge="1" parent="1" source="a2" target="oob"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oob_a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;dashPattern=4 4;strokeColor=#B91C1C;strokeWidth=1.1;" edge="1" parent="1" source="a3" target="oob"><mxGeometry relative="1" as="geometry"/></mxCell>
