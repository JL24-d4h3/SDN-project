        <mxCell id="e_nice" value="NIC-E ↔ A2 p6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;dashPattern=6 4;strokeColor=#334155;strokeWidth=1.4;fontSize=9.5;" edge="1" parent="1" source="nic_e" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_espejo" value="A4 p47 → espejo (solo RX)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;dashPattern=6 4;strokeColor=#B91C1C;strokeWidth=1.8;fontSize=10;fontColor=#B91C1C;fontStyle=1;" edge="1" parent="1" source="a4" target="nic_d"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- OOB -->
        <mxCell id="oob" value="CANAL DE CONTROL OUT-OF-BAND — separado físicamente del plano de datos&#xa;ma1 × 8 (una por switch) → switch de gestión aislado → ONOS 10.0.0.20:6653 · OpenFlow 1.3&#xa;whitelist del controlador · latido ECHO cada 5 s · los flujos OpenFlow jamás circulan por la VLAN 20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE4E2;strokeColor=#A33B33;strokeWidth=1.5;fontColor=#B91C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="740" width="870" height="76" as="geometry"/></mxCell>
