        <!-- Resumen -->
        <mxCell id="res" value="Resumen&#xa;• 8 switches Pica8: 2 núcleo, 2 distribución, 4 acceso&#xa;• 13 enlaces inter-switch (8 acceso-distribución + 4 distribución-núcleo + 1 inter-núcleo)&#xa;• todo acceso dual-homed: p1 → D1, p2 → D2&#xa;• espejo perimetral: A4 p47 → NIC-D (solo RX)&#xa;• OOB: ma1 × 8, medio físico separado&#xa;• convención de MAC: 52:54:00:xx:yy" style="text;html=1;align=left;verticalAlign=top;spacingTop=4;fontColor=#334155;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1000" y="300" width="340" height="160" as="geometry"/></mxCell>
