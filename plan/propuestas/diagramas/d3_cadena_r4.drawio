        <mxCell id="pres" value="T_mitigate = T_detect + T_event + T_policy + T_I2 + T_OF + T_ASIC ≈ 15 s + 0.185 s ≈ 15.2 s (patrón lento N=3) · ≈ 5.2 s (vía rápida N=1) — presupuesto de diseño, se mide en el prototipo" style="text;html=1;align=left;fontColor=#334155;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="1240" height="24" as="geometry"/></mxCell>
