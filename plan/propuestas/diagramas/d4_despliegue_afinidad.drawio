        <mxCell id="t" value="Despliegue agrupado por afinidad — la lógica no se fusiona, solo se co-localiza" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="800" height="30" as="geometry"/></mxCell>
        <mxCell id="sub" value="Los diez servicios siguen siendo procesos distintos con fronteras intactas; los contenedores pueden co-localizarse por afinidad operacional (de partida: un contenedor por servicio)." style="text;html=1;align=left;fontColor=#64748B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1100" height="20" as="geometry"/></mxCell>

