# Plantilla de variables de entorno.
# Copiar a .env (ignorado por git) y completar con valores reales al
# desplegar. Nunca versionar el .env real; para el slice se prefiere
# Ansible Vault, y estas variables son el respaldo para el uso local.
COMPOSE_DIR=/opt/campus-sdn/deploy/compose
TZ=America/Lima

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
RABBITMQ_USER=plataforma
RABBITMQ_PASSWORD=
LDAP_ADMIN_PASSWORD=
LDAP_READONLY_PASSWORD=
RADIUS_SECRET=
GRAFANA_ADMIN_PASSWORD=

# Servicios propios de S1
# STUB_VERIFY=1 acepta cualquier credencial: solo para pruebas, jamás en
# el slice. BUS_URL apunta al bus (S4): amqp://usuario:clave@<ip-s4>:5672.
# IAM_URL lo usa la Consola para el SSO del operador. RADIUS_HOST es el
# FreeRADIUS de S1 (IdP simulado del reino comunidad). I2_URL apunta al
# adaptador del controlador (VM de onos1, puerto 8090).
STUB_VERIFY=
BUS_URL=
IAM_URL=
RADIUS_HOST=freeradius
I2_URL=

# S2 — Observabilidad
# Interfaz del espejo hacia el sensor (se confirma en H0).
MIRROR_IFACE=ens5
